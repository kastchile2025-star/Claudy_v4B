{
  "name": "claudy",
  "version": "0.1.0",
  "description": "Claw'D — AI Assistant CLI + Desktop Pet",
  "type": "module",
  "bin": {
    "claudy": "./dist/cli.js",
    "clawd": "./src/desktop/pet.py"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup src/cli.ts --format esm --outDir dist",
    "postbuild": "node -e \"const fs=require('fs');const f='dist/cli.js';const c=fs.readFileSync(f,'utf8');if(!c.startsWith('#!'))fs.writeFileSync(f,'#!/usr/bin/env node\\n'+c);try{fs.chmodSync(f,0o755)}catch(e){}\"",
    "start": "node dist/cli.js",
    "desktop": "python src/desktop/pet.py",
    "test": "vitest",
    "link-global": "npm run build && npm link",
    "unlink-global": "npm unlink -g claudy"
  },
  "dependencies": {
    "axios": "^1.6.5",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "dotenv": "^16.3.1",
    "inquirer": "^9.2.10",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "ora": "^8.0.1"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.10.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
